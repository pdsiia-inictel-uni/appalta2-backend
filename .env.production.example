# Copiar a .env.production y completar. NUNCA subir .env.production al repositorio.

# --- Base de datos de producción (existente) ---
# Si PostgreSQL corre en el mismo servidor que Docker, usar host.docker.internal como host.
DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASEÑA@HOST:5432/appalta2

# --- URL pública del API (la que usa la app) ---
# Los enlaces de verificación y recuperación se arman como {BACKEND_URL}/v1/user/...
# y el proxy de producción redirige /api/palta/ → /api/ del backend.
BACKEND_URL=https://proyectos-didt.inictel-uni.edu.pe/api/palta

# --- Correo de verificación y recuperación (Gmail) ---
# MAIL_PASSWORD: contraseña de aplicación de Google (16 caracteres), no la contraseña normal.
MAIL_USERNAME=correo@gmail.com
MAIL_PASSWORD=Password
MAIL_FROM=correo@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# --- Asistente IA ---
LLM_MODEL=gemma4:e2b
LLM_MAX_CONCURRENCY=2
LLM_QUEUE_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180
TIMEZONE=America/Lima

# --- Puerto publicado en el servidor (el proxy HTTPS apunta aquí) ---
BACKEND_PORT=8000
